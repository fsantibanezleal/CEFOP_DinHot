{
  "external_environments_required": true,
  "environment_namespace": "dinhot",
  "readiness_excludes": [
    "readiness"
  ],
  "stage_inputs": [
    "data/examples/cases.json",
    "tests/fixtures/engine/camera.measure.json",
    "tests/fixtures/engine/device.crosstalk.json",
    "tests/fixtures/engine/device.crosstalk_adjoint.json",
    "tests/fixtures/engine/device.device_focal_field.json",
    "tests/fixtures/engine/device.displayed_phase.json",
    "tests/fixtures/engine/device.pixel_envelope.json",
    "tests/fixtures/engine/device.quantize.json",
    "tests/fixtures/engine/dynamics.boltzmann_check.json",
    "tests/fixtures/engine/dynamics.psd_fit.json",
    "tests/fixtures/engine/dynamics.trajectories.json",
    "tests/fixtures/engine/forward.angular_spectrum.json",
    "tests/fixtures/engine/forward.axial_cut.json",
    "tests/fixtures/engine/forward.fft_focal_field.json",
    "tests/fixtures/engine/forward.fft_inverse.json",
    "tests/fixtures/engine/forward.point_trap_backproject.json",
    "tests/fixtures/engine/forward.point_trap_fields.json",
    "tests/fixtures/engine/forward.trap_fields_from_fft.json",
    "tests/fixtures/engine/geometry.setup_functions.json",
    "tests/fixtures/engine/live.M04.json",
    "tests/fixtures/engine/live.M06.json",
    "tests/fixtures/engine/live.M07.json",
    "tests/fixtures/engine/live.M11.json",
    "tests/fixtures/engine/methods.M01.json",
    "tests/fixtures/engine/methods.M02.json",
    "tests/fixtures/engine/methods.M03.json",
    "tests/fixtures/engine/methods.M04.json",
    "tests/fixtures/engine/methods.M05.json",
    "tests/fixtures/engine/methods.M06.json",
    "tests/fixtures/engine/methods.M07.json",
    "tests/fixtures/engine/methods.M08.json",
    "tests/fixtures/engine/methods.M10.json",
    "tests/fixtures/engine/methods.M11.json",
    "tests/fixtures/engine/methods.M12.json",
    "tests/fixtures/engine/methods.M14.json",
    "tests/fixtures/engine/methods.M15.json",
    "tests/fixtures/engine/methods.M16.json",
    "tests/fixtures/engine/methods.M19.json",
    "tests/fixtures/engine/methods.assignment.json",
    "tests/fixtures/engine/metrics.power_budget.json",
    "tests/fixtures/engine/metrics.trap_metrics.json",
    "tests/fixtures/engine/modes.phases.json",
    "tests/fixtures/engine/rng.stream.json",
    "tests/fixtures/engine/trapphys.formulas.json",
    "tests/fixtures/engine/traps.generators.json",
    "tests/fixtures/engine/zernike.noll_to_nm.json",
    "tests/fixtures/engine/zernike.wavefront.json"
  ],
  "readiness_exceptions": {
    "params-record": "partial",
    "benchmark-results": "partial",
    "warmstart-model": "training",
    "api": "missing"
  },
  "readiness_check": "scripts/check_readiness.py",
  "primary_environment": ".venv-pipeline",
  "generation_environments": [
    ".venv-pipeline"
  ],
  "environments": [
    {
      "path": ".venv-pipeline",
      "requirements": [
        "requirements-precompute.txt",
        "requirements-dev.txt"
      ]
    },
    {
      "path": ".venv",
      "when": "api",
      "requirements": [
        "requirements-api.txt"
      ]
    },
    {
      "path": ".venv-notebooks",
      "when": "notebooks",
      "requirements": [
        "notebooks/requirements.txt"
      ]
    },
    {
      "path": ".venv-gpu",
      "when": "gpu",
      "requirements": [
        "requirements-gpu.txt"
      ]
    }
  ],
  "node_stamp": ".caos-package-lock.sha256",
  "required": [
    "data/derived/manifests/index.json",
    "data/derived/readiness.json",
    "data/derived/benchmark/results.json",
    "data/derived/models/metrics.json"
  ],
  "promote": [
    "data/derived",
    "models"
  ],
  "api": {
    "environment": ".venv",
    "active": "auto",
    "port": 8000,
    "health": "/health",
    "command": [
      "{python}",
      "-m",
      "uvicorn",
      "app.main:app",
      "--host",
      "127.0.0.1",
      "--port",
      "{port}"
    ]
  },
  "web_port": 5173,
  "frontend_environment": {
    "CAOS_DATA_ROOT": "{root}/data/derived"
  },
  "frontend_prepare": [
    [
      "{npm}",
      "run",
      "predev"
    ]
  ],
  "frontend_command": [
    "node",
    "node_modules/vite/bin/vite.js",
    "--host",
    "127.0.0.1",
    "--port",
    "{web_port}",
    "--strictPort"
  ],
  "generation": [
    {
      "script": "scripts/local/dinhot_bridge.py",
      "args": [
        "stage-learned",
        "{stage}"
      ]
    },
    {
      "script": "data-pipeline/run.py",
      "args": [
        "all",
        "--output",
        "{derived}"
      ]
    },
    {
      "script": "data-pipeline/run.py",
      "args": [
        "benchmark",
        "--output",
        "{derived}"
      ]
    },
    {
      "script": "data-pipeline/run.py",
      "args": [
        "readiness",
        "--output",
        "{derived}"
      ]
    },
    {
      "script": "scripts/local/dinhot_bridge.py",
      "args": [
        "finalize",
        "{stage}"
      ]
    }
  ],
  "validators": [
    {
      "script": "scripts/local/dinhot_bridge.py",
      "args": [
        "validate",
        "{stage}"
      ]
    },
    {
      "script": "scripts/check_artifacts.py",
      "args": [
        "{stage}"
      ]
    },
    {
      "script": "scripts/check_documents.py",
      "args": [
        "{stage}"
      ]
    }
  ],
  "generation_modules": [
    "numpy"
  ]
}
