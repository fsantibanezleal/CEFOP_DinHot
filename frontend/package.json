{
  "name": "dinhot-frontend",
  "private": true,
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-data.mjs",
    "contracts:types": "node scripts/gen-contract-types.mjs",
    "contracts:check": "node scripts/gen-contract-types.mjs --check",
    "build": "node scripts/gen-contract-types.mjs --check && tsc --noEmit && vite build && node scripts/materialize-routes.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run",
    "gate": "node scripts/gate.mjs",
    "engine:browser": "node scripts/engine-browser.mjs --assert"
  },
  "dependencies": {
    "@fasl-work/caos-app-shell": "0.19.6",
    "fft.js": "4.0.4",
    "katex": "0.19.1",
    "lucide-react": "^1.52.0",
    "onnxruntime-web": "1.31.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "0.186.1",
    "uplot": "^1.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "^5.0.3"
  }
}
