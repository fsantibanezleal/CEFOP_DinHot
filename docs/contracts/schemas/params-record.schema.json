{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "params-record.schema.json",
  "title": "ParamsRecord",
  "description": "Contract 1 (ingestion), catalog row params-record 1.0.0: one case as accepted by data-pipeline/pipeline/io/contract.py. The source document data/examples/cases.json is an array of records; every value arrives typed and is never coerced. Rules the schema cannot state, checked by the producer and consumer tests: trap ids are unique within a target, reference_method is one of methods, a trap lies inside the unaliased field of view (abs(x_um) and abs(y_um) at most lambda f / (2 p), in micrometres), and a missing, non-numeric, NaN or out-of-range value is rejected with its reason. A rejected record is dropped, the bake goes on with the accepted ones and readiness lists the rejected case ids (partial). Case C11 is rejected by design: the index records it as refused with the reason. Lengths carry _um, _nm or _mm, angles _rad, times _s, frequencies _hz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "setup",
    "device",
    "target",
    "aberration",
    "methods",
    "reference_method",
    "budget",
    "seed",
    "feedback",
    "dynamics",
    "rearrangement",
    "expect"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^C[0-9]{2}_[a-z0-9_]+$",
      "description": "The case id (C01 to C12)."
    },
    "setup": {
      "$ref": "#/$defs/setup"
    },
    "device": {
      "oneOf": [
        {
          "$ref": "#/$defs/device"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "aberration": {
      "oneOf": [
        {
          "$ref": "#/$defs/aberration"
        },
        {
          "type": "null"
        }
      ]
    },
    "methods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/method_id"
      },
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true
    },
    "reference_method": {
      "$ref": "#/$defs/method_id"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "feedback": {
      "oneOf": [
        {
          "$ref": "#/$defs/feedback"
        },
        {
          "type": "null"
        }
      ]
    },
    "dynamics": {
      "oneOf": [
        {
          "$ref": "#/$defs/dynamics"
        },
        {
          "type": "null"
        }
      ]
    },
    "rearrangement": {
      "oneOf": [
        {
          "$ref": "#/$defs/rearrangement"
        },
        {
          "type": "null"
        }
      ]
    },
    "expect": {
      "$ref": "#/$defs/expect"
    }
  },
  "$defs": {
    "aberration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noll"
      ],
      "properties": {
        "noll": {
          "type": "object",
          "propertyNames": {
            "pattern": "^([2-9]|1[0-9]|2[01])$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": -5,
            "maximum": 5
          },
          "description": "Noll index 2 to 21 to coefficient in waves."
        }
      },
      "description": "System aberration in waves."
    },
    "beam": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "waist_frac"
          ],
          "properties": {
            "kind": {
              "const": "gaussian"
            },
            "waist_frac": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "flat"
            }
          }
        }
      ],
      "description": "The input beam; waist_frac belongs to the gaussian beam only."
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iterations",
        "time_s"
      ],
      "properties": {
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "time_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.01,
          "maximum": 3600
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gain_rms",
        "noise_rms",
        "blur_bins"
      ],
      "properties": {
        "gain_rms": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "noise_rms": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2
        },
        "blur_bins": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "crosstalk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sigma_per_px",
        "q"
      ],
      "properties": {
        "sigma_per_px": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10
        },
        "q": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bit_depth",
        "crosstalk",
        "upsample",
        "fill_factor",
        "flicker_rad",
        "lut_gamma"
      ],
      "properties": {
        "bit_depth": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 16
        },
        "crosstalk": {
          "oneOf": [
            {
              "$ref": "#/$defs/crosstalk"
            },
            {
              "type": "null"
            }
          ]
        },
        "upsample": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "fill_factor": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        },
        "flicker_rad": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lut_gamma": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      },
      "description": "The SLM device model; the whole object null means the ideal device."
    },
    "dynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "particle",
        "trap_id",
        "power_mw",
        "temperature_k",
        "n_steps",
        "dt_s"
      ],
      "properties": {
        "particle": {
          "enum": [
            "bead",
            "atom"
          ]
        },
        "trap_id": {
          "type": "integer"
        },
        "power_mw": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 5000
        },
        "bead_radius_um": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 5
        },
        "n_particle": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 2.0
        },
        "viscosity_pa_s": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 0.1
        },
        "temperature_k": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 400
        },
        "mass_amu": {
          "type": "number",
          "minimum": 1,
          "maximum": 300
        },
        "detuning_thz": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "n_steps": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 200000
        },
        "dt_s": {
          "type": "number",
          "minimum": 1e-09,
          "maximum": 0.001
        }
      },
      "description": "The trapped-particle simulation; the bead fields belong to a bead, the atom fields to an atom.",
      "allOf": [
        {
          "if": {
            "properties": {
              "particle": {
                "const": "bead"
              }
            },
            "required": [
              "particle"
            ]
          },
          "then": {
            "required": [
              "bead_radius_um",
              "n_particle",
              "viscosity_pa_s"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "particle": {
                "const": "atom"
              }
            },
            "required": [
              "particle"
            ]
          },
          "then": {
            "required": [
              "mass_amu",
              "detuning_thz"
            ]
          }
        }
      ]
    },
    "expect": {
      "type": "object",
      "description": "The checked expectation of the case: [low, high] per result metric.",
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gain",
        "steps",
        "camera"
      ],
      "properties": {
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "camera": {
          "$ref": "#/$defs/camera"
        }
      },
      "description": "The camera loop (M12, B6)."
    },
    "method_id": {
      "type": "string",
      "pattern": "^(M[0-9]{2}|B[0-9])$",
      "description": "A method id: M01 to M99 or B0 to B9."
    },
    "rearrangement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loading_p",
        "target_ids",
        "alpha",
        "steps_per_move"
      ],
      "properties": {
        "loading_p": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "target_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "alpha": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "steps_per_move": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "description": "The rearrangement case (M16, B2)."
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wavelength_nm",
        "focal_mm",
        "na",
        "n_imm",
        "n_pix",
        "pitch_um",
        "pad",
        "beam"
      ],
      "properties": {
        "wavelength_nm": {
          "type": "number",
          "minimum": 300,
          "maximum": 2000
        },
        "focal_mm": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1000
        },
        "na": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.5
        },
        "n_imm": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 1.6
        },
        "n_pix": {
          "type": "integer",
          "enum": [
            64,
            128,
            256,
            512,
            1024
          ],
          "description": "SLM side in pixels (square)."
        },
        "pitch_um": {
          "type": "number",
          "minimum": 1,
          "maximum": 50
        },
        "pad": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "beam": {
          "$ref": "#/$defs/beam"
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "traps"
          ],
          "properties": {
            "kind": {
              "const": "traps"
            },
            "traps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/trap"
              },
              "minItems": 1,
              "maxItems": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "shape",
            "signal_margin_bins"
          ],
          "properties": {
            "kind": {
              "const": "shaped"
            },
            "shape": {
              "enum": [
                "ring",
                "disc",
                "line",
                "top_hat",
                "lg_ring"
              ]
            },
            "radius_um": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000
            },
            "width_um": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000
            },
            "length_um": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000
            },
            "signal_margin_bins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            }
          }
        }
      ],
      "description": "What to make: a trap list or a shaped potential."
    },
    "trap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x_um",
        "y_um",
        "z_um",
        "weight",
        "charge"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "x_um": {
          "type": "number",
          "minimum": -100000.0,
          "maximum": 100000.0
        },
        "y_um": {
          "type": "number",
          "minimum": -100000.0,
          "maximum": 100000.0
        },
        "z_um": {
          "type": "number",
          "minimum": -100000.0,
          "maximum": 100000.0
        },
        "weight": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        },
        "charge": {
          "type": "integer",
          "minimum": -20,
          "maximum": 20
        }
      },
      "description": "One trap; ids are unique within a target (a rule the schema cannot state)."
    }
  }
}
