{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-results.schema.json",
  "title": "BenchmarkResults",
  "description": "Contract 2 (artifact), catalog row benchmark-results 1.0.0: the protocol's table, method by geometry by budget, written by data-pipeline/pipeline/stages/benchmark.py to data/derived/benchmark/results.json. Missing data: a cell that was not run is absent from rows and listed in skipped.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "engine_version",
    "protocol",
    "geometries",
    "rows",
    "pareto"
  ],
  "properties": {
    "schema": {
      "const": "dinhot.benchmark/v1"
    },
    "engine_version": {
      "$ref": "#/$defs/version"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grids",
        "seeds",
        "budgets",
        "device"
      ],
      "properties": {
        "grids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "seeds": {
          "type": "integer"
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iterations",
            "time_s"
          ],
          "properties": {
            "iterations": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "time_s": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "device": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "geometries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "n_traps",
          "dims"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G[1-7]$"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "n_traps": {
            "type": "integer"
          },
          "dims": {
            "enum": [
              2,
              3
            ]
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "geometry",
          "device",
          "budget_kind",
          "budget",
          "params",
          "n_seeds",
          "efficiency",
          "uniformity",
          "rel_std_pct",
          "time_s",
          "iterations"
        ],
        "properties": {
          "method": {
            "$ref": "#/$defs/method_id"
          },
          "geometry": {
            "type": "string",
            "pattern": "^G[1-7]$"
          },
          "device": {
            "enum": [
              "ideal",
              "device"
            ]
          },
          "budget_kind": {
            "enum": [
              "iterations",
              "time",
              "converged"
            ]
          },
          "budget": {
            "type": "number"
          },
          "params": {
            "enum": [
              "default",
              "tuned"
            ]
          },
          "n_seeds": {
            "type": "integer"
          },
          "efficiency": {
            "$ref": "#/$defs/stat"
          },
          "uniformity": {
            "$ref": "#/$defs/stat"
          },
          "rel_std_pct": {
            "$ref": "#/$defs/stat"
          },
          "time_s": {
            "$ref": "#/$defs/stat"
          },
          "iterations": {
            "$ref": "#/$defs/stat"
          }
        }
      }
    },
    "pareto": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "geometry",
          "method",
          "points"
        ],
        "properties": {
          "geometry": {
            "type": "string",
            "pattern": "^G[1-7]$"
          },
          "method": {
            "const": "B5"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lambda",
                "efficiency",
                "uniformity"
              ],
              "properties": {
                "lambda": {
                  "type": "number"
                },
                "efficiency": {
                  "type": "number"
                },
                "uniformity": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "geometry",
          "reason"
        ],
        "properties": {
          "method": {
            "$ref": "#/$defs/method_id"
          },
          "geometry": {
            "type": "string",
            "pattern": "^G[1-7]$"
          },
          "reason": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "description": "The cells that were not run; absent from rows."
    }
  },
  "$defs": {
    "method_id": {
      "type": "string",
      "pattern": "^(M[0-9]{2}|B[0-9])$",
      "description": "A method id: M01 to M99 or B0 to B9."
    },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median",
        "q1",
        "q3"
      ],
      "properties": {
        "median": {
          "type": "number"
        },
        "q1": {
          "type": "number"
        },
        "q3": {
          "type": "number"
        }
      },
      "description": "Median and inter-quartile range over the seeds or the held-out set."
    },
    "text": {
      "type": "object",
      "description": "Every reader-facing string is bilingual at the source.",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}\\.\\d{3}$",
      "description": "The product version format X.XX.XXX."
    }
  }
}
